{
  "name": "grana-leve",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Ferramenta de controle financeiro pessoal para jovens e famílias (projeto de Atividade Extensionista).",
  "scripts": {
    "dev": "serve -l 5500 .",
    "lint": "eslint js tests tools supabase",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/run.js",
    "check": "npm run lint && npm test",
    "sw:update": "node tools/update-sw.js",
    "test:db": "node supabase/tests/run.js",
    "build": "node tools/build.js",
    "preview": "serve -l 5501 dist"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "puppeteer-core": "25.13.0",
    "serve": "14.2.6"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
